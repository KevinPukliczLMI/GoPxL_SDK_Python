# Copy to repo root as pyproject.toml when publishing on GitHub.
# Repo layout: pyproject.toml + GoPxL_SDK_Py/

[build-system]
requires = ["setuptools>=61", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "gopxl-sdk"
version = "0.3.0"
description = "Python SDK for programmatic control of Gocator / GoPxL sensors"
requires-python = ">=3.9"
license = { text = "MIT" }
authors = [{ name = "LMI Technologies Inc." }]
dependencies = [
    "msgpack>=1.0.0",
]

[project.scripts]
gopxl-copy-samples = "gopxl_sdk.copy_samples:main"

[tool.setuptools.package-dir]
gopxl_sdk = "GoPxL_SDK_Py"

[tool.setuptools]
packages = ["gopxl_sdk"]
include-package-data = true

[tool.setuptools.package-data]
gopxl_sdk = ["samples/**/*.py"]